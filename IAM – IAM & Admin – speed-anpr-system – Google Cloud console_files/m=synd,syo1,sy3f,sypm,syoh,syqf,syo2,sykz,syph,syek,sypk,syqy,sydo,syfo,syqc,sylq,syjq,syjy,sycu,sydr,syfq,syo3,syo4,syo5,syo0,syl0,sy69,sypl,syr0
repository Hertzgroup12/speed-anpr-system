"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_Save_Sheets.yaml":"task:\n- id: bqUXR_Save_Sheets\n  group_label: prod\n  description: |-\n    CUJ task defined in slides:\n    https://docs.google.com/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4/edit?resourcekey=0-2jYDyvwY-c3fSCASwnNP8A&slide=id.g33fd7bbeca1_1_106#slide=id.g33fd7bbeca1_1_106\n\n    Copying a dataset to sheets\n  product_name: BigQuery\n  implementation:\n  - name: new_implementation\n    signal:\n    - id: click_google_sheets\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: startSaveAsToSheet\n      type: BEGIN\n      description: Task starts when user clicks google sheets from save results menu\n    - id: google_sheets_complete\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: saveAsToSheet\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when job completes, and FULL\n        results sheet has been created\n    - id: unable_to_save_full_sheet\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: limitedSaveAsToSheet\n      type: FAIL\n      description: Task is failed if only partial save is completed\n    begin_date: '2025-03-06'\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_copy_results_to_Clipboard.yaml":"task:\n- id: bqUXR_copy_results_to_Clipboard\n  group_label: prod\n  description: |-\n    CUJ task defined in slides:\n    https://docs.google.com/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4/edit?resourcekey=0-2jYDyvwY-c3fSCASwnNP8A&slide=id.g33fd7bbeca1_1_54#slide=id.g33fd7bbeca1_1_54\n\n    Copying a dataset to a clipboard\n  product_name: BigQuery\n  implementation:\n  - name: new_implementation\n    signal:\n    - id: click_copy_to_clipboard\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: startSaveAsToClipboard\n      type: BEGIN\n      description: Task starts when user clicks Copy to clipboard from save results\n        menu\n    - id: Clipboard_Copy_Complete\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: saveAsToClipboard\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when job completes, and results\n        have been copied to clipboard\n    - id: Copy_to_Clipboard_Cancel\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: cancelSaveAsToClipboard\n      type: TERMINATE\n      description: 'Task is terminated if user clicks \u2018cancel\u2019 in progress popup '\n    - id: Clipboard_Limited_Copy\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: limitedSaveAsToClipboard\n      type: FAIL\n      description: Task is failed if only partial copy is completed\n    begin_date: '2025-03-06'\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_explorer_search.yaml":"task:\n- id: bqUXR_explorer_search\n  group_label: prod\n  description: |-\n    Searching for an existing data asset via explorer. CUJ defined in Slides:\n\n    https://docs.google.com/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4/edit?resourcekey=0-2jYDyvwY-c3fSCASwnNP8A&slide=id.g33f9872b08b_0_21#slide=id.g33f9872b08b_0_21\n  product_name: BigQuery\n  implementation:\n  - signal:\n    - id: explorer_search_input\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqTree\n          event_name: search\n      type: BEGIN\n    - id: search_result_click\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqTree\n          event_name: nodeClicked\n      type: COMPLETE\n    - id: explorer_search_X_clicked\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqTree\n          event_name: searchClear\n      type: TERMINATE\n    begin_date: '2025-03-05'\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_export_results_to_GCS.yaml":"task:\n- id: bqUXR_export_results_to_GCS\n  group_label: prod\n  name: Export Results to GCS Triggered Survey\n  description: |-\n    CUJ task defined in slides:\n    docs/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4?slide=id.g3613cddf1cf_0_0&pli=1&resourcekey=0-2jYDyvwY-c3fSCASwnNP8A#slide=id.g3613cddf1cf_0_0\n\n    Export Results to GCS\n  product_name: BigQuery\n  implementation:\n  - name: query_result_action_bar\n    signal:\n    - id: click_GCS\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: startSaveAsToGCS\n      type: BEGIN\n      description: Task starts when user clicks Cloud Storage from save results\n    - id: GCS_Save_Complete\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: saveAsToGCS\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when job completes, and table\n        has been exported to GCS\n    - id: GCS_Limited_Save\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: failedSaveAsToGCS\n      type: FAIL\n      description: CUJ-task fails when export job fails\n    - id: GCS_Cancel\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: cancelSaveAsToGCS\n      type: TERMINATE\n      description: Task is terminated if user clicks \u2018cancel\u2019 in subtask\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_new_explorer_search.yaml":"task:\n- id: bqUXR_new_explorer_search\n  group_label: prod\n  description: |-\n    Searching for an existing data asset via NEW explorer. CUJ defined in Slides:\n\n    https://docs.google.com/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4/edit?resourcekey=0-2jYDyvwY-c3fSCASwnNP8A&slide=id.g3746e970b80_2_61#slide=id.g3746e970b80_2_61\n  product_name: BigQuery\n  implementation:\n  - signal:\n    - id: studioSearchTabOpen\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqStudioSearchTab\n          event_name: studioSearchTabOpen\n      type: BEGIN\n      description: CUJ-task starts when user enters text into *new* explorer search\n        bar & the new search TAB opens.\n    - id: studioSearchTabResourceOpen\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqStudioSearchTab\n          event_name: studioSearchTabResourceOpen\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when user opens a resource,\n        from the list on the search tab\n    - id: newexplorer_search_X_clicked\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqStudioSearchTab\n          event_name: newexplorer_search_X_clicked\n      type: TERMINATE\n      description: Explorer filter terminates when user clicks \u2018X\u2019 in filter bar\n    begin_date: '2024-08-11'\n",
