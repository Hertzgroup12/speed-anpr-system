ignal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_panel_close\n      type: TERMINATE\n      description: user closes "Generate SQL with Gemini" panel\n    - id: gemini_code_gen_fail\n      front_end_signal:\n        console_type: Cloud_Console\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_fail\n      type: FAIL\n      description: CUJ is failed when gemini sends an error message instead of generating\n        SQL\n    begin_date: \'2024-08-11\'\n',
